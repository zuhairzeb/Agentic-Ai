GOOGLE_API_KEY=
# Gemini's preferred current name; GOOGLE_API_KEY remains a supported legacy alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_CONFIRMED=false
# Optional web search APIs. DuckDuckGo remains available without either key.
WEB_SEARCH_PROVIDER=DuckDuckGo
SERPER_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_FREE_TIER_CONFIRMED=false
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b
LLM_PROVIDER_PRIORITY=gemini,groq,cloudflare,openrouter,ollama
LLM_ENABLED_PROVIDERS=gemini,groq,cloudflare,openrouter,ollama
# FREE_ONLY filters to verified free-tier models and requires the relevant free-plan confirmation flags.
FREE_ONLY=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
LLM_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=
APP_ARTIFACT_DIR=data/generated
# Set APP_GREETING_NAME to personalize both the greeting and browser/sidebar name.
APP_NAME=
APP_GREETING_NAME=
APP_TAGLINE=What are we working on?
APP_DESCRIPTION=A local workspace for questions, research, writing, and interactive builds.
APP_LOGO=
APP_FAVICON=

# Optional path to the folder containing your Markdown knowledge base.
# Defaults to ../sociapi_agent_knowledge_base (Markdown files are searched recursively).
SOCIAPI_KNOWLEDGE_DIR=
