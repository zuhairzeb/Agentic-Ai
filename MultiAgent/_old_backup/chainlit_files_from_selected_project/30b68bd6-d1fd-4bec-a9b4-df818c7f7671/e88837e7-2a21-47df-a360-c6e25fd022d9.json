{"files": {"index.html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Event Registration</title><style>:root{font-family:system-ui;color:#14213d;background:#f4f7fb}body{margin:0;padding:2rem}.card{max-width:40rem;margin:2rem auto;padding:2rem;background:white;border-radius:1.5rem;box-shadow:0 20px 60px #1232}label{display:grid;gap:.4rem;margin:.8rem 0}input{padding:.8rem;border:1px solid #cbd5e1;border-radius:.7rem}button{padding:.9rem 1.2rem;background:#14213d;color:white;border:0;border-radius:.8rem}#success{color:#087443}</style></head><body><main class=\"card\"><h1>Event Registration</h1><p>Reserve your place. All fields are required.</p><form id=\"registration\"><label>Event name<input name=\"eventName\" required value=\"Community Design Night\"></label><label>Date<input name=\"date\" type=\"date\" required></label><label>Location<input name=\"location\" required value=\"Studio Hall\"></label><label>Attendee name<input name=\"attendee\" required></label><label>Email<input name=\"email\" type=\"email\" required></label><button type=\"submit\">Register</button><p id=\"success\" role=\"status\" aria-live=\"polite\"></p></form></main><script>document.getElementById('registration').addEventListener('submit',function(event){event.preventDefault();if(this.reportValidity())document.getElementById('success').textContent='You are registered!';});</script></body></html>"}, "title": "modern Event Registration Form", "preview": true}