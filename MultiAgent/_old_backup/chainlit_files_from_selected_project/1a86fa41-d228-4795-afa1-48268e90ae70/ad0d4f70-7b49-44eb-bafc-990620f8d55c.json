{"files": {"index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Event Registration</title>\n<style>\n:root{--primary:#4CAF50;--bg:#f9f9f9;--text:#333;}\nbody{font-family:Arial,sans-serif;background:var(--bg);color:var(--text);margin:0;padding:0;}\n.container{max-width:500px;margin:2rem auto;padding:1rem;background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);}\nh1{text-align:center;margin-bottom:1rem;}\nlabel{display:block;margin-top:1rem;font-weight:bold;}\ninput{width:100%;padding:.5rem;margin-top:.5rem;border:1px solid #ccc;border-radius:4px;}\ninput:focus{outline:none;border-color:var(--primary);}\nbutton{margin-top:1.5rem;width:100%;padding:.75rem;background:var(--primary);color:white;border:none;border-radius:4px;font-size:1rem;cursor:pointer;}\nbutton:hover{background:#45a049;}\n.success{display:none;margin-top:1rem;padding:.75rem;background:#dff0d8;color:#3c763d;border-radius:4px;text-align:center;}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h1>Event Registration</h1>\n<form id=\"regForm\" novalidate>\n<label for=\"eventName\">Event Name</label>\n<input type=\"text\" id=\"eventName\" name=\"eventName\" required>\n<label for=\"eventDate\">Event Date</label>\n<input type=\"date\" id=\"eventDate\" name=\"eventDate\" required>\n<label for=\"eventLocation\">Event Location</label>\n<input type=\"text\" id=\"eventLocation\" name=\"eventLocation\" required>\n<label for=\"attendeeName\">Your Name</label>\n<input type=\"text\" id=\"attendeeName\" name=\"attendeeName\" required>\n<label for=\"attendeeEmail\">Your Email</label>\n<input type=\"email\" id=\"attendeeEmail\" name=\"attendeeEmail\" required>\n<button type=\"submit\">Register</button>\n</form>\n<div id=\"successMsg\" class=\"success\">Registration successful!</div>\n</div>\n<script>\nconst form=document.getElementById('regForm');\nconst successMsg=document.getElementById('successMsg');\nform.addEventListener('submit',function(e){\ne.preventDefault();\nif(form.checkValidity()){\nsuccessMsg.style.display='block';\nform.reset();\nsetTimeout(()=>{successMsg.style.display='none';},3000);\n}else{\nform.reportValidity();\n}\n});\n</script>\n</body>\n</html>"}, "title": "modern Event Registration Form", "preview": true}